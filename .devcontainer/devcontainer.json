{
    "image": "mcr.microsoft.com/devcontainers/javascript-node:4-24",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4": {
            "moby": "false" // does not work with Debian Trixie based images
        }
    },
    "remoteUser": "node",
    "remoteEnv": {
        "SCORE_TOOLS_BIN": "/home/node/.local/share/score-tools/bin",
        "PATH": "/home/node/.local/share/score-tools/bin:${containerEnv:PATH}"
    },
    "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/post_create_command.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "mads-hartmann.bash-ide-vscode",
                "dbaeumer.vscode-eslint",
                "EditorConfig.EditorConfig"
            ],
            "settings": {
                "files.insertFinalNewline": true
            }
        }
    }
}
