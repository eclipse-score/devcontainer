{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Commit author
  gitAuthor: "eclipse-score-bot <score-bot@eclipse.org>",
  // Only the self-hosted daily job has permission to run post-upgrade tasks.
  // It overrides this setting with RENOVATE_FORCE to avoid competing runners.
  "enabled": false,
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "UTC",
  "schedule": [
    "at any time"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "semanticCommits": "enabled",
  "commitMessagePrefix": "feat(deps):",
  "prConcurrentLimit": 5,
  "prCreation": "immediate",
  "automerge": false,
  // Refresh only the updated native lockfile: older, unrelated releases may
  // have no GitHub asset digests.
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "tools/lockfiles/*.lock.json"
      ],
      // The match reaches into binaries to discover the release repository.
      // Replace only the first version occurrence; refresh owns archive paths.
      "autoReplaceGlobalMatch": false,
      "postUpgradeTasks": {
        "commands": [
          "tools/internal/refresh_lockfile_digests.py {{{packageFile}}}"
        ],
        "fileFilters": [
          "tools/lockfiles/*.lock.json"
        ],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "src/s-core-devcontainer/.devcontainer/devcontainer.json"
      ],
      "postUpgradeTasks": {
        "commands": [
          "npx --yes @devcontainers/cli upgrade --workspace-folder src/s-core-devcontainer"
        ],
        "fileFilters": [
          "src/s-core-devcontainer/.devcontainer/devcontainer-lock.json"
        ],
        "executionMode": "update"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/lockfiles/[^/]+\\.lock\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>[^\"]+)\"[\\s\\S]*?\"url\":\\s*\"https://github.com/(?<depName>[^/]+/[^/]+)/releases/download/"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src\\/s-core-devcontainer\\/\\.devcontainer\\/devcontainer\\.json$/"
      ],
      "matchStrings": [
        "ghcr\\.io/eclipse-score/mcp-servers/agent-context:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "eclipse-score/mcp-servers",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/providers\\.json$/"
      ],
      "matchStrings": [
        "\"provider\":\\s*\"python\",\\s*\"package\":\\s*\"(?<depName>[^\"]+)\",\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "ignoreDeps": [],
  "labels": [
    "type:dependencies"
  ],
  "reviewers": [
    "team:maintainers"
  ]
}
