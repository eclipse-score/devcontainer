{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Only the self-hosted daily job has permission to run post-upgrade tasks.
  // It overrides this setting with RENOVATE_FORCE to avoid competing runners.
  "enabled": false,
  "extends": [
    "config:base",
    ":dependencyDashboard",
    ":semanticCommits",
    "github>aquaproj/aqua-renovate-config:file#2.8.0(tools/owners/aqua/aqua\\.yaml)"
  ],
  "timezone": "UTC",
  "schedule": [
    "at any time"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 5,
  "prCreation": "immediate",
  "automerge": false,
  "postUpgradeTasks": {
    "commands": [
      "python3 tools/internal/aqua/refresh_owners.py"
    ],
    "fileFilters": ["**/*"],
    "executionMode": "update"
  },
  "ignorePaths": [
    "**/experiments/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "tools/owners/aqua/aqua-bootstrap.toml"
      ],
      "matchStrings": [
        "version = .*?(?<currentValue>[0-9][0-9.]+)"
      ],
      "depNameTemplate": "aquaproj/aqua",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "enabledManagers": [
    "custom.regex",
    "pep621"
  ],
  "ignoreDeps": [],
  "labels": [
    "type:dependencies"
  ],
  "reviewers": [
    "team:maintainers"
  ]
}
