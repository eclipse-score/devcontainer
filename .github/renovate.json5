{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Only the self-hosted daily job has permission to run post-upgrade tasks.
  // It overrides this setting with RENOVATE_FORCE to avoid competing runners.
  "enabled": false,
  "extends": [
    "config:base",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "UTC",
  "schedule": [
    "at any time"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 5,
  "prCreation": "immediate",
  "automerge": false,
  "postUpgradeTasks": {
    "commands": [
      "tools/internal/mise/refresh.sh"
    ],
    "fileFilters": ["**/*"],
    "executionMode": "update"
  },
  // mise owns every live tool version; experiments are not dependency owners.
  "ignorePaths": ["experiments/**"],
  "enabledManagers": ["mise"],
  "ignoreDeps": [],
  "labels": [
    "type:dependencies"
  ],
  "reviewers": [
    "team:maintainers"
  ]
}
