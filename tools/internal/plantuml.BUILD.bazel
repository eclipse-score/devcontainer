"""Targets for the complete native PlantUML bundle in its external repository."""

load("@rules_multitool//multitool:cwd.bzl", "cwd")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

# The raw launcher preserves the working directory of the action invoking it.
# Keep the entire bundle in runfiles: PlantUML loads rendering libraries from
# the directory beside its executable, including when run in an action sandbox.
sh_binary(
    name = "plantuml_binary",
    srcs = ["plantuml_binary.sh"],
    data = glob(["bundle/**"]) + ["@bazel_tools//tools/bash/runfiles"],
)

# Interactive calls use the same cwd wrapper as other native tools. It changes
# to BUILD_WORKING_DIRECTORY and forwards the raw launcher's complete runfiles.
cwd(
    name = "plantuml",
    tool = ":plantuml_binary",
)
