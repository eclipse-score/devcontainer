load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":multitool.bzl", "multitool_aliases")
load(":python_tool.bzl", "python_tool")
load(":score_tools/python_tools.bzl", "PYTHON_TOOLS")

package(default_visibility = ["//visibility:public"])

# Native lockfiles are consumed by rules_multitool; the Starlark catalog is
# loaded directly by python_tool.bzl. Export both because they are public
# metadata shipped with the score_devcontainer module.
exports_files(glob([
    "score_tools/*.bzl",
    "lockfiles/*.bzl",
    "lockfiles/*.lock.json",
]))

multitool_aliases("actionlint")

multitool_aliases("bazelisk")

multitool_aliases("buildifier")

multitool_aliases("ruff")

multitool_aliases("shellcheck")

multitool_aliases("starpls")

multitool_aliases("uv")

multitool_aliases("uvx")

multitool_aliases("yamlfmt")

multitool_aliases("apm")

multitool_aliases("opencode")

# Python distributions are resolved through pinned uvx because they do not
# provide the platform-specific release binaries consumed by rules_multitool.
# Derive every public Python target from the owning dictionary. Adding a tool
# must not require synchronizing a second handwritten command list here.
[python_tool(name) for name in PYTHON_TOOLS]

# This contract test preserves the public uvx argument, cwd, and exit boundary.
sh_test(
    name = "python_tool_runner_test",
    srcs = ["tests/python_tool_runner_test.sh"],
    data = [
        "internal/devcontainer/install.py",
        "internal/run_python_tool.sh",
        "score_tools/__init__.py",
        "score_tools/catalog.py",
        "score_tools/python_tools.bzl",
    ],
)

sh_test(
    name = "run_tool_test",
    size = "small",
    srcs = ["tests/run_tool_test.sh"],
    data = [
        "run-tool",
    ],
)

py_test(
    name = "mise_provision_test",
    srcs = ["tests/test_mise_provision.py"],
    data = [
        "environments.json",
        "internal/mise/provision.py",
        "mise/mise.native.toml",
        "mise/mise.published.toml",
        "mise/mise.python.toml",
        "score_tools/__init__.py",
        "score_tools/catalog.py",
        "score_tools/python_tools.bzl",
    ] + glob(["lockfiles/*.lock.json"]),
    main = "tests/test_mise_provision.py",
    python_version = "PY3",
)

# Check ordinary package metadata without making experiments part of the
# maintained updater or release generator.
py_test(
    name = "mise_python_package_test",
    srcs = ["tests/test_mise_python_package.py"],
    data = [
        "internal/mise/python_package.py",
        "internal/mise/refresh.py",
        "mise/mise.native.toml",
        "mise/mise.python.toml",
        "score_tools/__init__.py",
        "score_tools/catalog.py",
        "score_tools/python_tools.bzl",
    ],
    main = "tests/test_mise_python_package.py",
    python_version = "PY3",
)
