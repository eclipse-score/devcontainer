# Consumer repositories install this runner as .devcontainer/run-tool.
# It runs a container command directly, a local PATH command on the host when
# available, or the selected Bazel target otherwise. Host --strict uses only a
# provisioner-created mise link before falling back to Bazel.
# See https://github.com/eclipse-score/devcontainer/tree/main/tools.

set -euo pipefail

strict=0
if [[ "${1:-}" == "--strict" ]]; then
    strict=1
    shift
fi

if [[ "$#" -lt 1 ]]; then
    echo "Usage: $0 [--strict] <tool> [args...]" >&2
    exit 2
fi

tool_name="$1"
shift

# Tests can force either side of the container boundary without changing the
# runtime's automatic detection behavior.
in_container() {
    case "${RUN_TOOL_CONTAINER_MODE:-auto}" in
        host) return 1 ;;
        container) return 0 ;;
        auto)
            [[ -f /.dockerenv ]] || [[ -f /run/.containerenv ]] || [[ -d /devcontainer ]]
            ;;
        *)
            echo "Invalid RUN_TOOL_CONTAINER_MODE: ${RUN_TOOL_CONTAINER_MODE}" >&2
            return 2
            ;;
    esac
}

# Strict host mode must not trust an arbitrary executable found through PATH.
# provision.py creates absolute symlinks into mise's versioned install tree;
# that installed path is the evidence that the executable was provisioned.
provisioned_tool() {
    local bin_dir candidate target
    local -a bin_dirs=()
    if [[ -n "${SCORE_TOOLS_BIN_DIR:-}" ]]; then
        bin_dirs+=("${SCORE_TOOLS_BIN_DIR}")
    else
        if [[ -n "${HOME:-}" ]]; then
            bin_dirs+=("${HOME}/.local/bin")
        fi
        bin_dirs+=("/usr/local/bin")
    fi

    for bin_dir in "${bin_dirs[@]}"; do
        candidate="${bin_dir}/${tool_name}"
        if [[ -L "${candidate}" && -x "${candidate}" ]]; then
            target="$(readlink "${candidate}")"
            if [[ "${target}" == */installs/* ]]; then
                printf '%s\n' "${candidate}"
                return 0
            fi
        fi
    done
    return 1
}

# Container PATH remains preferred for compatibility, including --strict.
# Container detection is an execution shortcut, not a version attestation.
# shellcheck disable=SC2310
if in_container && command -v "${tool_name}" >/dev/null 2>&1; then
    exec "${tool_name}" "$@"
# Prepared strict host calls resolve only links created by the provisioner.
# The link target contains the selected backend/version under mise's installs/
# tree, so arbitrary PATH entries cannot shadow the selected executable.
elif [[ "${strict}" -eq 1 ]] && provisioned_command="$(provisioned_tool)"; then
    exec "${provisioned_command}" "$@"
# On the host, prefer the local tool on PATH for faster execution unless --strict
# is set. If local execution fails, suggest --strict to use the provisioned or
# pinned Bazel executable.
elif [[ "${strict}" -eq 0 ]] && command -v "${tool_name}" >/dev/null 2>&1; then
    if "${tool_name}" "$@"; then
        exit 0
    else
        exit_code=$?
        echo "Execution of local '${tool_name}' failed with exit code ${exit_code}." >&2
        echo "Use '--strict' to use the provisioned tool or pinned version via Bazel." >&2
        exit "${exit_code}"
    fi
elif command -v bazel >/dev/null 2>&1; then
    # Consumer repositories expose this module as @score_devcontainer; `--`
    # prevents tool flags from being interpreted as Bazel flags.
    exec bazel run "@score_devcontainer//tools:${tool_name}" -- "$@"
else
    echo "Could not run '${tool_name}': no container command or Bazel executable is available." >&2
    exit 127
fi
